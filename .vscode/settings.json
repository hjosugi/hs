{
  "haskell.manageHLS": "PATH",
  "haskell.serverExecutablePath": "${workspaceFolder}/bin/hls",
  "haskell.formattingProvider": "fourmolu",
  "[haskell]": {
    "editor.defaultFormatter": "haskell.haskell",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  }
}
