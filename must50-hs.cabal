cabal-version: 2.4
name: must50-hs
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
    Must50DCore
    Solutions.MergeIntervals
    Solutions.MeetingRoomsII
    Solutions.NumberOfIslands
    Solutions.StatusMessageDeduplication
    Solutions.CourseSchedule
    Solutions.WordLadder
    Solutions.NetworkDelayTime
    Solutions.LRUCache
    Solutions.TopKFrequentElements
    Solutions.MedianFinder
    Solutions.LongestSubstringWithoutRepeatingCharacters
    Solutions.ImplementTrie
    Solutions.WordSearchII
    Solutions.SlidingWindowMaximum
    Solutions.WordBreak
    Solutions.HouseRobber
    Solutions.PartitionEqualSubsetSum
    Solutions.LongestIncreasingSubsequence
    Solutions.BinaryTreeMaximumPathSum
    Solutions.DailyTemperatures
    Solutions.CombinationSum
    Solutions.KokoEatingBananas
    Solutions.RedundantConnection
    Solutions.SubarraySumEqualsK
    Solutions.IncrementSubmatrices
    Solutions.MinimumCostToCutOffAllLeaves
  other-modules:
    Common.Arrays
    Common.Heap
    Common.Example
  hs-source-dirs: .
  build-depends: base >= 4.14 && < 5, array, containers, hashtables
  default-language: Haskell2010
  ghc-options: -Wall

executable must50-hs
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base >= 4.14 && < 5, must50-hs
  default-language: Haskell2010
  ghc-options: -Wall

test-suite examples
  type: exitcode-stdio-1.0
  main-is: Check.hs
  hs-source-dirs: test
  build-depends: base >= 4.14 && < 5, must50-hs
  default-language: Haskell2010
  ghc-options: -Wall
